<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drillpulse_autonomous</name>
  <version>1.0.0</version>
  <description>Complete self-contained ROS2 autonomous driving package for DrillPulse Mini Rover featuring OpenCV vision obstacle detection, ultrasonic safety manager, free roam mode, point-to-point navigation, and lightweight path planning.</description>

  <maintainer email="drillpulse@rover.local">DrillPulse Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
